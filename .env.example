# Start with testnet. Promote reviewed image digests to mainnet later.
NETWORK=testnet

# Immutable component revisions.
NODE_RELEASE=v1.1.2.0-testnet
NODE_AMD64_SHA256=ea1cc46a5d867289f50915d81ac19efb2a72855ec03c47eb0729ff8cdb955985
NODE_ARM64_SHA256=6fff27bb275c026a4b265b1301aebf9ac1c954c873018e0a9e41715ed3056c57
WALLET_REF=94ee002ec00b50f35c57e377d672930f6c86ad1d
RPC_BRIDGE_REF=96074907643ae25efd043cc02ed28fd407c27882
BLOCKBOOK_REF=bfeb91020e9f900e316aaade639d3f021280e055

# Publish only the gateway.
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
CADDY_SITE=:80

# Testnet node defaults.
NODE_RPC_PORT=49718
NODE_P2P_PORT=49716
NODE_RPC_THREADS=8
NODE_RPC_WORK_QUEUE=64

# Bound public bridge work.
RPC_TIMEOUT_MS=15000
RPC_RESPONSE_LIMIT_BYTES=8388608
REQUESTS_PER_MINUTE=120
SENSITIVE_REQUESTS_PER_MINUTE=20
MAX_RATE_LIMIT_CLIENTS=10000

# Bound Blockbook work.
BLOCKBOOK_RPC_TIMEOUT=25
MEMPOOL_WORKERS=8
MEMPOOL_SUB_WORKERS=2
BLOCK_ADDRESSES_TO_KEEP=300
