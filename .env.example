# Start with testnet. Promote reviewed image digests to mainnet later.
NETWORK=testnet

# Immutable component revisions.
NODE_RELEASE=v1.1.13-testnet
NODE_AMD64_SHA256=0abc4e27dd1e744bf2306cc7fee6a05c3a95848fc6385e636a82630cee87684c
NODE_ARM64_SHA256=b0f3f8397bb1e471e224051a37c3272633f2b8153a58e3c799e3c30288d8b021
WALLET_REF=8a310ef3304c67f70e6fe7255447140c36c2d0ad
RPC_BRIDGE_REF=545612e1b9ffb1e536cfc004900a91f814b3caed
BLOCKBOOK_REF=1af4295e2f10c66cf0e51b0ef21f70a7203b98a1

# Publish only the gateway.
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
CADDY_SITE=:80

# Testnet node defaults.
NODE_RPC_PORT=49718
NODE_P2P_PORT=49716
NODE_RPC_THREADS=8
NODE_RPC_WORK_QUEUE=64

# Bound public bridge work.
RPC_TIMEOUT_MS=15000
RPC_RESPONSE_LIMIT_BYTES=8388608
REQUESTS_PER_MINUTE=120
MAX_RATE_LIMIT_CLIENTS=10000

# Bound Blockbook work.
BLOCKBOOK_RPC_TIMEOUT=25
MEMPOOL_WORKERS=8
MEMPOOL_SUB_WORKERS=2
BLOCK_ADDRESSES_TO_KEEP=300
