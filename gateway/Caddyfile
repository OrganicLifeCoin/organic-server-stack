:8081 {
	@health path /healthz
	respond @health "healthy" 200
}

{$CADDY_SITE::80} {
	encode zstd gzip

	request_body {
		max_size 6MB
	}

	header {
		-Server
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Opener-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	@health path /healthz
	handle @health {
		respond "healthy" 200
	}

	@rpc path /mainnet* /testnet*
	handle @rpc {
		reverse_proxy rpc-bridge:8080
	}

	@sapling path /sapling-output.params /sapling-spend.params
	handle @sapling {
		root * /srv/olc-params
		header Cache-Control "public, max-age=86400"
		file_server
	}

	@blockbook path /api* /websocket /blocks* /block/* /tx/* /address/* /xpub/* /mempool* /status* /sendtx* /static/*
	handle @blockbook {
		reverse_proxy blockbook:9130
	}

	handle {
		reverse_proxy wallet:80
	}
}
